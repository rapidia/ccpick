# ccpick 플랜 정의 예시
#
# 형식: <플랜이름>=<CLAUDE_CODE_OAUTH_TOKEN>
#   - '#' 으로 시작하는 줄과 빈 줄은 무시됩니다.
#   - 플랜이름은 fzf 목록에 표시됩니다 (공백 없이).
#
# 설치:
#   mkdir -p ~/.config/ccpick
#   cp plans.env.example ~/.config/ccpick/plans.env
#   chmod 600 ~/.config/ccpick/plans.env
#   # 이후 실제 토큰으로 채우세요.
#
pro=sk-ant-oat01-여기에-pro-토큰을-넣으세요
max=sk-ant-oat01-여기에-max-토큰을-넣으세요
